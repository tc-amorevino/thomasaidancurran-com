---
import { cn, getSiteUrl } from '@/lib/utils';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'title'> {
  class?: string;
}

const { class: className } = Astro.props;
const root = getSiteUrl(Astro.site);
---

<a
  href={root}
  title="Thomas Aidan Curran Homepage"
  class={cn(
    'aspect-square bg-white font-mono leading-none flex flex-col gap-1 justify-center size-20 text-primary',
    className,
  )}>
  <span class="block"># THOMAS</span>
  <span class="block">#&nbsp;&nbsp;AIDAN</span>
  <span class="block"># CURRAN</span>
  <span class="block">########</span>
</a>
