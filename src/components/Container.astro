---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  class?: string;
}

const defaultClass = 'mx-auto max-w-6xl px-6 md:px-12';
const { class: className = defaultClass, ...attrs } = Astro.props;
---

<div class={`${defaultClass} ${className ? className : ''}`.trim()} {...attrs}>
  <slot />
</div>
