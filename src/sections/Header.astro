---
import { headerLinksNav } from '@/cms/link-lists';
import Link from '@/components/Link.astro';
import Logo from '@/components/Logo.astro';
import { cn } from '@/lib/utils';

const isActive = (link: (typeof headerLinksNav)[number]) => {
  return link.href === Astro.url.href
    ? 'bg-popover text-popover-foreground'
    : null;
};
---

<header
  id="hidable-header"
  class="bg-card sticky top-0 z-10 border-y py-0.75">
  <div class="border-y bg-white">
    <div class="canvas-outer bg-dotted bg-background/60 overflow-visible">
      <div class="canvas-inner flex flex-col gap-3 py-2.75">
        <div
          class="border-border m-auto rounded-xl border bg-white px-2.75 py-1.75">
          <Logo />
        </div>
        <div class="scrollbar-hidden -mx-2 overflow-x-scroll px-2 sm:mr-0">
          <nav
            class="border-border m-auto w-min overflow-hidden rounded-full border bg-white p-0.75">
            <ul class="flex flex-row flex-nowrap">
              {
                headerLinksNav.map((link) => (
                  <li class={cn('rounded-full px-3', isActive(link))}>
                    <Link
                      href={link.href}
                      class="text-sm tracking-wider">
                      {link.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>
