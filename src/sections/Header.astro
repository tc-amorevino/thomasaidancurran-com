---
import { cn, makeUrl, getSiteUrl } from '@/lib/utils';
import Logo from '@/components/Logo.astro';
import Link from '@/components/Link.astro';
import { headerLinksNav } from '@/cms/link-lists';
import '@/styles/custom-utils.css';

const root = getSiteUrl(Astro.site);
const isActive = (link: (typeof headerLinksNav)[number]) => {
  return link.href === Astro.url.pathname
    ? 'bg-popover text-popover-foreground'
    : null;
};
---

<header id="hidable-header" class="sticky top-0 z-10 border-y bg-card py-[3px]">
  <div class="border-y bg-white">
    <div class="canvas-outer bg-dotted overflow-visible bg-background/60">
      <div class="canvas-inner flex flex-col gap-4 py-[11px]">
        <div class="m-auto rounded-xl border border-border bg-white p-[11px]">
          <Logo />
        </div>
        <div class="scrollbar-hidden -mr-2 overflow-x-scroll sm:mr-0">
          <nav
            class="m-auto w-min overflow-hidden rounded-full border border-border bg-white">
            <ul class="flex flex-row flex-nowrap">
              {
                headerLinksNav.map((link) => (
                  <li class={cn('rounded-full px-4 py-[3px]', isActive(link))}>
                    <Link
                      href={makeUrl(root, link.href)}
                      class="text-sm tracking-wider">
                      {link.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('hidable-header');

  if (header) {
    let lastScrollY = window.scrollY;
    // Ensure transition classes are present for smooth animation
    header.classList.add('transition-transform', 'duration-300', 'ease-in-out');

    const getHeaderHeight = () => {
      // getBoundingClientRect().height is generally more reliable as offsetHeight can be 0
      // if the element or its parents are display:none or not yet fully rendered.
      const rect = header.getBoundingClientRect();
      return rect.height > 0 ? rect.height : header.offsetHeight;
    };

    const updateHeaderVisibility = () => {
      const currentScrollY = window.scrollY;
      const headerHeight = getHeaderHeight();

      // If headerHeight is still 0 (e.g. not fully rendered) and we've scrolled,
      // it's safer to not hide it yet. The next scroll event will likely have the correct height.
      // However, if at top (currentScrollY is 0), always show.
      if (headerHeight <= 0 && currentScrollY > 0) {
        return;
      }

      // Determine scroll direction and apply visibility changes
      if (currentScrollY > lastScrollY) {
        // Scrolling Down
        // Hide only if scrolled past the header's height
        if (currentScrollY > headerHeight) {
          header.classList.add('-translate-y-full');
        }
      } else {
        // Scrolling Up or at the very top
        header.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY <= 0 ? 0 : currentScrollY; // Handles top of page and negative scroll values
    };

    // Initialize and attach listener
    const initializeAutoHideHeader = () => {
      lastScrollY = window.scrollY; // Set initial scroll position
      updateHeaderVisibility(); // Set initial state based on current scroll
      window.addEventListener('scroll', updateHeaderVisibility, {
        passive: true,
      });
    };

    // Wait for the 'load' event to ensure all resources (CSS, images) are loaded
    // and the header's dimensions are accurate. A small timeout can provide an
    // extra buffer for any late layout shifts.
    if (document.readyState === 'complete') {
      // If 'load' already fired
      setTimeout(initializeAutoHideHeader, 50);
    } else {
      window.addEventListener('load', () => {
        setTimeout(initializeAutoHideHeader, 50);
      });
    }
  } else {
    // Header not found, no need to initialize
  }
</script>
