---
import { footerLinksSite, footerLinksSocial } from '@/cms/link-lists.ts';
import Link from '@/components/Link.astro';

const currentYear = new Date().getFullYear();
---

<div class="canvas-outer bg-secondary">
  <div class="canvas-inner h-8 border-x"></div>
</div>
<footer class="canvas-outer bg-secondary border-t">
  <div class="canvas-inner border-x">
    <div class="bg-stripes-diagonal flex justify-center gap-2 px-1.75 py-4">
      <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2">
        <div class="flex flex-col gap-1">
          <div class="bg-secondary p-2">
            <p class="text-secondary-foreground text-sm font-semibold">Site</p>
          </div>
          <div class="bg-secondary grow p-2">
            <ul class="flex flex-col gap-2">
              {
                footerLinksSite.map((link) => (
                  <li>
                    <Link
                      href={link.href}
                      class="text-secondary-foreground text-sm underline underline-offset-4">
                      {link.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <div class="bg-secondary p-2">
            <p class="text-secondary-foreground text-sm font-semibold">
              Social
            </p>
          </div>
          <div class="bg-secondary grow p-2">
            <ul class="flex flex-col gap-2">
              {
                footerLinksSocial.map((link) => (
                  <li>
                    <Link
                      href={link.href}
                      target={'_blank'}
                      rel="noopener"
                      title={`Connect with Thomas Aidan Curran on ${link.title}`}
                      class="text-secondary-foreground text-sm underline underline-offset-4"
                      classExternal="text-xs text-secondary-foreground/80">
                      {link.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<div class="canvas-outer bg-secondary border-t">
  <div class="canvas-inner border-x px-3.75 py-4">
    <span class="text-secondary-foreground/80 text-xs"
      >Copyright &copy; {currentYear} Thomas Aidan Curran</span
    >
  </div>
</div>
