---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

import * as PublicationsIntro from '@/cms/blocks/publications.mdx';
import Link from '@/components/Link.astro';
import LayoutMain from '@/layouts/LayoutMain.astro';
import { type SeoValidate } from '@/lib/utils';
import { getSiteUrl, makeUrl } from '@/lib/utils';
import Post from '@/sections/Post.astro';

const Content = PublicationsIntro.Content;

const publications = await getCollection('publications');

const root = getSiteUrl(Astro.site);
const seo: SeoValidate = {
  page_title: 'Books and Publications by Thomas Aidan Curran',
  page_description:
    'Explore "SAP R/3 Business Blueprint" and other key publications by Thomas Aidan Curran on business process reengineering, AI, and digital transformation.',
  canonical_url: makeUrl(root, Astro.url.pathname),
};

/**
 * Edit the publications page text here:
 * {@link src/cms/blocks/publications.mdx}
 * {@link src/.json-schemas/publications-schema.json}
 */
---

<LayoutMain seo={seo}>
  <div slot="main" class="-mt-px flex grow flex-col">
    <div class="canvas-outer border-t">
      <div class="canvas-inner o h-8 border-x"></div>
    </div>
    <Post>
      <Content slot="post" />
    </Post>
    <div class="canvas-outer border-t">
      <div class="canvas-inner o h-8 border-x"></div>
    </div>
    <div class="canvas-outer border-t">
      <div class="canvas-inner border-x">
        <div
          class="grid auto-rows-fr grid-cols-1 gap-px bg-border md:grid-cols-2">
          {
            publications.map((publication) => (
              <div class="flex flex-col justify-between bg-white p-4">
                <div class="pb-2">
                  <div class="mb-3 flex h-[250px] items-center justify-center overflow-hidden">
                    {publication.data.image && (
                      <Picture
                        class={'m-auto'}
                        src={publication.data.image}
                        densities={[2]}
                        height={250}
                        formats={['webp', 'jpg']}
                        loading={'lazy'}
                        quality={'high'}
                        alt={`${publication.data.type} ${publication.data.title}`}
                      />
                    )}
                  </div>
                  <p class="mb-1 font-mono text-xs tracking-wider text-foreground/80">
                    [{publication.data.type}, {publication.data.year}]
                  </p>
                  <p class="text-lg">{publication.data.title}</p>
                </div>
                <p>
                  <Link target={'_blank'} href={publication.data.href}>
                    Read
                  </Link>
                </p>
              </div>
            ))
          }
          {
            publications.length % 2 !== 0 && (
              <div class="bg-stripes-diagonal hidden bg-white md:block" />
            )
          }
        </div>
      </div>
    </div>
    <div class="canvas-outer -mb-px border-y">
      <div class="canvas-inner h-8 border-x"></div>
    </div>
  </div>
</LayoutMain>
