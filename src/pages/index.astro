---
import * as About from '@/cms/blocks/about.mdx';
import LayoutMain from '@/layouts/LayoutMain.astro';
import { type SeoValidate } from '@/lib/utils';
import Post from '@/sections/Post.astro';
import Profile from '@/sections/Profile.astro';

const Content = About.Content;

const seo: SeoValidate = {
  page_title: 'Thomas Aidan Curran Official Website',
  page_description:
    'Thomas Aidan Curran: Seasoned technologist and entrepreneur. Gain insights from his experience advising on AI, cybersecurity, and digital transformation.',
  canonical_url: 'https://thomasaidancurran.com/',
};

/**
 * Edit the home page text here:
 * {@link src/cms/blocks/about.mdx}
 */
---

<LayoutMain seo={seo}>
  <div slot="main" class="-mt-px flex grow flex-col">
    <div class="canvas-outer border-t">
      <div class="canvas-inner h-8 border-x"></div>
    </div>
    <Profile />
    <div class="canvas-outer border-t">
      <div class="canvas-inner h-8 border-x"></div>
    </div>
    <Post>
      <Content slot="post" />
    </Post>
    <div class="canvas-outer border-t">
      <div class="canvas-inner h-8 border-x"></div>
    </div>
  </div>
</LayoutMain>
