---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

import * as PortfolioIntro from '@/cms/blocks/portfolio.mdx';
import Link from '@/components/Link.astro';
import LayoutMain from '@/layouts/LayoutMain.astro';
import { type SeoValidate } from '@/lib/utils';
import { getSiteUrl, makeUrl } from '@/lib/utils';
import Post from '@/sections/Post.astro';

const Content = PortfolioIntro.Content;

const portfolio = await getCollection('portfolio');

const root = getSiteUrl(Astro.site);
const seo: SeoValidate = {
  page_title: 'Portfolio & Angel Investment of Thomas Aidan Curran',
  page_description:
    'Investments in next generation software companies focusing on AI to streamline business workflows and enhance decision-making.',
  canonical_url: makeUrl(root, Astro.url.pathname),
};

/**
 * Edit the publications page text here:
 * {@link src/cms/blocks/publications.mdx}
 * {@link src/.json-schemas/publications-schema.json}
 */
---

<LayoutMain seo={seo}>
  <div slot="main" class="-mt-px flex grow flex-col">
    <div class="canvas-outer border-t">
      <div class="canvas-inner o h-8 border-x"></div>
    </div>
    <Post>
      <Content slot="post" />
    </Post>
    <div class="canvas-outer border-t">
      <div class="canvas-inner o h-8 border-x"></div>
    </div>
    <div class="canvas-outer border-t">
      <div class="canvas-inner border-x">
        <div
          class="grid auto-rows-fr grid-cols-1 gap-px bg-border md:grid-cols-2">
          {
            portfolio.map((portfolioItem) => (
              <div class="flex flex-col justify-between bg-white p-4">
                <div class="pb-2">
                  <div class="mb-3 flex h-[200px] items-center justify-center overflow-hidden">
                    {portfolioItem.data.image && (
                      <Picture
                        class={'m-auto size-[200px]'}
                        src={portfolioItem.data.image}
                        height={600}
                        formats={['jpg', 'webp']}
                        loading={'lazy'}
                        quality={'high'}
                        alt={`${portfolioItem.data.type} ${portfolioItem.data.title}`}
                      />
                    )}
                  </div>
                  <p class="mb-1 font-mono text-xs tracking-wider text-foreground/80">
                    [{portfolioItem.data.type}]
                  </p>
                  <p class="text-lg">{portfolioItem.data.title}</p>
                  {portfolioItem.data.description && (
                    <p class="mt-2 text-sm text-foreground/70">
                      {portfolioItem.data.description}
                    </p>
                  )}
                </div>
                <p>
                  <Link target={'_blank'} href={portfolioItem.data.href}>
                    Visit
                  </Link>
                </p>
              </div>
            ))
          }
          {
            portfolio.length % 2 !== 0 && (
              <div class="bg-stripes-diagonal hidden bg-white md:block" />
            )
          }
        </div>
      </div>
    </div>
    <div class="canvas-outer -mb-px border-y">
      <div class="canvas-inner h-8 border-x"></div>
    </div>
  </div>
</LayoutMain>
