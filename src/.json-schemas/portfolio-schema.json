{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "image": {
        "type": "string"
      },
      "href": {
        "type": "string",
        "format": "uri"
      },
      "type": {
        "type": "string",
        "enum": ["advisor", "angel investor", "founder"]
      }
    },
    "required": ["slug", "title", "href", "type"],
    "additionalProperties": false
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
