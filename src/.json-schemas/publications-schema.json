{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "image": {
        "type": "string"
      },
      "href": {
        "type": "string",
        "format": "uri"
      },
      "year": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 9999
      },
      "type": {
        "type": "string",
        "enum": ["book", "article", "essay", "report", "other"]
      }
    },
    "required": ["slug", "title", "href", "year", "type"],
    "additionalProperties": false
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
